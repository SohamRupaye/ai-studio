{
  "name": "squirl",
  "version": "0.1.0",
  "private": true,
  "description": "Squirl - Model-agnostic organizational intelligence layer",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.1.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean",
    "dupcheck": "jscpd",
    "postinstall": "yarn workspace @squirl/desktop exec electron-rebuild -f -w better-sqlite3 || true",
    "rebuild:electron": "yarn workspace @squirl/desktop exec electron-rebuild -f -w better-sqlite3",
    "desktop:dev": "yarn workspace @squirl/desktop dev",
    "desktop:build": "yarn workspace @squirl/desktop build",
    "desktop:package": "yarn workspace @squirl/desktop package",
    "desktop:make": "yarn workspace @squirl/desktop make"
  },
  "devDependencies": {
    "@squirl/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "9.17.0",
    "jscpd": "5.4.3",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "^5.1.1"
  },
  "resolutions": {
    "@hono/node-server": "^2.1.6",
    "@xmldom/xmldom@^0.8.6": "^0.8.15",
    "@xmldom/xmldom@^0.9.10": "^0.9.12",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser@~1.20.5": "^1.20.9",
    "body-parser@^2.2.1": "^2.4.0",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^2.0.1": "^2.1.7",
    "brace-expansion@^2.0.2": "^2.1.7",
    "brace-expansion@^5.0.5": "^5.0.12",
    "browserslist": "^4.28.7",
    "esbuild@^0.27.0": "^0.28.1",
    "fast-uri@^3.0.1": "^3.1.9",
    "hono": "^4.13.16",
    "ip-address": "^10.7.4",
    "nanoid@^3.3.12": "^3.3.18",
    "postcss": "^8.5.23",
    "protobufjs@^7.2.4": "^7.6.5",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "tar@^7.0.1": "^7.5.21",
    "tar@^7.5.4": "^7.5.21",
    "undici@^6.25.0": "^6.29.1",
    "vite@^5.0.0 || ^6.0.0 || ^7.0.0-0": "^7.3.7"
  }
}
