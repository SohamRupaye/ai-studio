{
  "name": "squirl",
  "version": "0.1.0",
  "private": true,
  "description": "Squirl - Model-agnostic organizational intelligence layer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.1.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "postinstall": "yarn workspace @squirl/desktop exec electron-rebuild -f -w better-sqlite3 || true",
    "rebuild:electron": "yarn workspace @squirl/desktop exec electron-rebuild -f -w better-sqlite3",
    "desktop:dev": "yarn workspace @squirl/desktop dev",
    "desktop:build": "yarn workspace @squirl/desktop build",
    "desktop:package": "yarn workspace @squirl/desktop package",
    "desktop:make": "yarn workspace @squirl/desktop make"
  },
  "devDependencies": {
    "@squirl/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "9.17.0",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "^3.2.0"
  }
}
