{
  "name": "@squirl/desktop",
  "productName": "Squirl",
  "version": "0.1.0",
  "private": true,
  "description": "Squirl Desktop Application",
  "main": ".vite/build/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .vite out",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration.test.ts --passWithNoTests"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.0",
    "@squirl/ai-core": "workspace:*",
    "@squirl/context-engine": "workspace:*",
    "@squirl/database": "workspace:*",
    "@squirl/event-bus": "workspace:*",
    "@squirl/graph-engine": "workspace:*",
    "@squirl/prompt-engine": "workspace:*",
    "@squirl/providers": "workspace:*",
    "@squirl/shared": "workspace:*",
    "@squirl/tokenizer": "workspace:*",
    "@squirl/tools-runtime": "workspace:*",
    "@squirl/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "electron-liquid-glass": "1.1.1",
    "electron-squirrel-startup": "1.0.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.2",
    "simple-icons": "^16.25.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "patchright": "^1.52.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.6.0",
    "@electron-forge/maker-deb": "7.6.0",
    "@electron-forge/maker-dmg": "7.6.0",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "7.6.0",
    "@electron-forge/maker-zip": "7.6.0",
    "@electron-forge/plugin-vite": "7.6.0",
    "@electron/rebuild": "3.7.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
