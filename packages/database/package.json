{
  "name": "@squirl/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration.test.ts --passWithNoTests"
  },
  "dependencies": {
    "@squirl/shared": "workspace:*",
    "better-sqlite3": "11.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "typescript": "5.7.2",
    "vitest": "^5.1.1"
  }
}
